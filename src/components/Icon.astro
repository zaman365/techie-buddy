---
// Inline Lucide icon (ISC license), read from lucide-static at build time.
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 18, class: cls = '', label } = Astro.props;

const require = createRequire(import.meta.url);
const globalCache = globalThis as unknown as { __lucide?: Map<string, string> };
globalCache.__lucide ??= new Map();
let inner = globalCache.__lucide.get(name);
if (!inner) {
  const file = require.resolve(`lucide-static/icons/${name}.svg`);
  const raw = readFileSync(file, 'utf8');
  inner = raw.replace(/<!--[\s\S]*?-->/g, '').replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/\s+/g, ' ').trim();
  globalCache.__lucide.set(name, inner);
}
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' };
---
<svg
  class:list={['icon', cls]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
  set:html={inner}
/>
