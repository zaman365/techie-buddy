---
// Decorative: a week calendar with an automatic reminder chip.
const days = ['Mo', 'Di', 'Mi', 'Do', 'Fr'];
---
<div class="vg" aria-hidden="true">
  <div class="days">{days.map((d) => <span>{d}</span>)}</div>
  <div class="grid">
    <span class="slot s1">09:00 Färben</span>
    <span class="slot s2">11:30 Schnitt</span>
    <span class="slot s3">14:00 Beratung</span>
  </div>
  <div class="chip"><span class="dot"></span>Erinnerung gesendet · morgen 11:30</div>
</div>
<style>
  .vg {
    border: 1px solid var(--line-2);
    border-radius: var(--r-10);
    background: rgba(7, 11, 18, 0.6);
    padding: 10px;
    font-size: 11px;
    display: grid;
    gap: 8px;
  }
  .days {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    color: var(--text-3);
    font-family: var(--font-mono);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(3, 22px);
    gap: 4px;
  }
  .slot {
    border-radius: 5px;
    padding: 3px 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    background: var(--surface-2);
    color: var(--text-2);
    border-left: 2px solid var(--line-3);
  }
  .s1 {
    grid-column: 1 / span 2;
    grid-row: 1;
  }
  .s2 {
    grid-column: 2 / span 2;
    grid-row: 2;
    border-left-color: var(--accent);
    color: var(--text);
  }
  .s3 {
    grid-column: 4 / span 2;
    grid-row: 3;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    justify-self: start;
    padding: 4px 9px;
    border-radius: 999px;
    border: 1px solid var(--accent-line);
    background: var(--accent-wash);
    color: var(--text);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
