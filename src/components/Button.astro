---
import Icon from './Icon.astro';
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  iconAfter?: string;
  block?: boolean;
  external?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'secondary', size = 'md', icon, iconAfter, block, external, type = 'button', class: cls, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, size !== 'md' && `btn--${size}`, block && 'btn--block', cls];
const ext = external ? { rel: 'noopener', target: '_blank' } : {};
---
{
  href ? (
    <a href={href} class:list={classes} {...ext} {...rest}>
      {icon && <Icon name={icon} />}
      <slot />
      {iconAfter && <Icon name={iconAfter} />}
      {external && <span class="sr-only"> (öffnet in neuem Tab)</span>}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      {icon && <Icon name={icon} />}
      <slot />
      {iconAfter && <Icon name={iconAfter} />}
    </button>
  )
}
