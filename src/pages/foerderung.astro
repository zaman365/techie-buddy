---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TicketCard from '../components/TicketCard.astro';
import Icon from '../components/Icon.astro';
import FinalCta from '../components/FinalCta.astro';
import { getData, site, serviceUrl } from '../lib/data.ts';
import { eur } from '../lib/format.ts';
const { serviceById } = await getData();
const sab = serviceById.get('62')!;
const cards = ['63', '64', '65'].map((id) => serviceById.get(id)!);
const budget = 9000;
const sabFact = site.deadlines;
void sabFact;
const example = ['36', '39', '41', '38'].map((id) => serviceById.get(id)!);
---
<Base title="Förderung: Digitalisierung in Sachsen bezuschussen lassen" description="SAB-Digitalisierungsförderung für erste Projekte: bis zu 60 % für berechtigte Vorhaben, Antrag vor Projektstart. Wir prüfen, bündeln und setzen um.">
  <div class="container page-top">
    <header class="head">
      <h1>Förderung für dein Digitalisierungsprojekt</h1>
      <p class="lede">In Sachsen kann die SAB das erste Digitalisierungsprojekt eines Betriebs bezuschussen. Wir prüfen, ob dein Vorhaben passt, bündeln die passenden Leistungen und setzen nach der Bewilligung um.</p>
      <div class="cluster">
        <a class="btn btn--primary" href={`/kontakt/?leistung=${sab.slug}`}>Förderung prüfen lassen</a>
        <a class="btn btn--secondary" href="/wissen/foerder-check/">Kostenloser Förder-Check</a>
      </div>
    </header>
  </div>

  <section class="section section--raised section--line" aria-labelledby="how-title">
    <div class="container cols">
      <div>
        <SectionHeader id="how-title" title="So funktioniert die SAB-Förderung" />
        <ul class="facts" role="list">
          <li><Icon name="percent" /><p><strong>Bis zu 60 %</strong> der förderfähigen Kosten für berechtigte erste Digitalisierungsprojekte, laut Programm-Flyer der SAB.</p></li>
          <li><Icon name="calendar-x" /><p><strong>Antrag vor Projektstart.</strong> Wer vorher anfängt, verliert in der Regel den Anspruch. Deshalb beginnt die Umsetzung erst nach der Bewilligung.</p></li>
          <li><Icon name="user-check" /><p><strong>Du stellst den Antrag.</strong> Antragsteller ist dein Unternehmen. Wir bereiten Angebot und Unterlagen vor und begleiten dich im Portal.</p></li>
          <li><Icon name="scale" /><p><strong>Förderfähige Kosten haben Grenzen.</strong> Welche Kosten zählen und welche Mindest- und Höchstbeträge gerade gelten, prüfen wir für jeden Fall neu.</p></li>
        </ul>
        <p class="meta src">Stand {site.asOf.label}. Quelle: <a href="https://sab.sachsen.de/documents/d/guest/flyer_digitalisierung_efre-pdf?download=true" rel="noopener">SAB, Programm-Flyer Digitalisierung</a>. Programmverfügbarkeit und Bedingungen ändern sich; maßgeblich sind die aktuellen Unterlagen der SAB.</p>
      </div>
      <aside class="example panel" aria-labelledby="ex-title">
        <p class="example__tag">Beispiel</p>
        <h3 id="ex-title">Handwerksbetrieb, Projektbudget {eur(budget)}</h3>
        <ul class="example__list" role="list">
          {example.map((s) => <li><a href={serviceUrl(s)}>{s.name}</a></li>)}
        </ul>
        <div class="example__calc">
          <span>davon förderfähig bis zu 60 %</span>
          <span class="mono">bis zu {eur(budget * 0.6)}</span>
        </div>
        <p class="meta">Rechenbeispiel ohne Gewähr. Umfang und Preise legen wir im kostenlosen Erstgespräch fest; ob und wie viel gefördert wird, entscheidet die SAB.</p>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="cards-title">
    <div class="container">
      <SectionHeader id="cards-title" title="Passende Leistungen" text="Vom Check bis zum Projekt." />
      <ul class="tickets" role="list">
        <li><TicketCard service={sab} /></li>
        {cards.map((s) => <li><TicketCard service={s} /></li>)}
      </ul>
      <div class="note guard">
        <Icon name="info" />
        <p><strong>Administrative Unterstützung, keine Förderzusage.</strong> {site.guardrail}</p>
      </div>
    </div>
  </section>

  <FinalCta title="Passt dein Vorhaben?" text="Beschreib kurz, was du digitalisieren willst und wann du starten möchtest. Wir sagen dir ehrlich, ob eine Förderung realistisch ist." />
</Base>
<style>
  .head {
    max-width: 820px;
    display: grid;
    gap: var(--s-5);
    margin-bottom: var(--s-16);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-12);
    align-items: start;
  }
  .facts {
    display: grid;
    gap: var(--s-5);
  }
  .facts li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: var(--s-4);
    color: var(--text-2);
  }
  .facts :global(.icon) {
    color: var(--accent);
    margin-top: 3px;
  }
  .facts strong {
    color: var(--text);
    font-weight: 600;
  }
  .src {
    margin-top: var(--s-8);
  }
  .src a {
    color: var(--text);
  }
  .example {
    padding: var(--s-6);
    display: grid;
    gap: var(--s-4);
  }
  .example__tag {
    font-size: var(--fs-12);
    color: var(--text-3);
  }
  .example h3 {
    font-size: var(--fs-20);
  }
  .example__list {
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-14);
  }
  .example__list a {
    color: var(--text-2);
  }
  .example__list a:hover {
    color: var(--text);
  }
  .example__calc {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-size: var(--fs-14);
  }
  .example__calc .mono {
    color: var(--accent);
    white-space: nowrap;
  }
  .tickets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .guard {
    margin-top: var(--s-8);
  }
  @media (max-width: 900px) {
    .cols,
    .tickets {
      grid-template-columns: 1fr;
    }
  }
</style>
