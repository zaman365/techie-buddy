---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import { getData, serviceUrl } from '../lib/data.ts';
const { serviceById } = await getData();
const s = (id: string) => ({ name: serviceById.get(id)!.name, href: serviceUrl(serviceById.get(id)!) });
const partners = [
  { who: 'Steuerberatung', icon: 'calculator', text: 'Mandanten fragen nach DATEV, E-Rechnung und Zeiterfassung. Du klärst das Steuerliche, wir setzen die Technik um.', items: [s('54'), s('03'), s('66'), s('68')], note: 'Ohne Provision: Steuerberater dürfen für Empfehlungen keine Vergütung annehmen (§ 9 StBerG). Wir bieten gegenseitige Empfehlungen und gemeinsames Infomaterial.' },
  { who: 'Versicherungsmakler', icon: 'shield-check', text: 'Kunden scheitern am Fragebogen der Cyber-Versicherung. Wir setzen die geforderten Maßnahmen technisch um.', items: [s('79'), s('53'), s('78')], note: null },
  { who: 'Webdesign und Agenturen', icon: 'pen-tool', text: 'Barrierefreiheit, Consent und kleine Fixes, die sich für euch nicht rechnen. Wir übernehmen sie zum Festpreis.', items: [s('01'), s('05'), s('22')], note: null },
  { who: 'Solarteure und Elektriker', icon: 'sun', text: 'Nach der Montage kommen die Fragen: Marktstammdatenregister, Apps, Monitoring. Wir nehmen sie dir ab.', items: [s('74'), s('75'), s('77')], note: null },
  { who: 'Bestatter und Notariate', icon: 'archive', text: 'Hinterbliebene brauchen Hilfe mit Konten, Fotos und digitalen Spuren. Einfühlsam und über offizielle Wege.', items: [s('34'), s('71'), s('72')], note: null },
  { who: 'M&A- und Nachfolgeberatung', icon: 'key-round', text: 'Vor dem Verkauf die IT dokumentieren, nach der Übernahme modernisieren. Das macht Übergaben planbar.', items: [s('69'), s('70'), s('29')], note: null }
];
---
<Base title="Partnerprogramm: Empfehlungen, die deinen Kunden helfen" description="Für Steuerberatung, Versicherungsmakler, Agenturen, Solarteure, Bestatter und Nachfolgeberater: Kunden mit digitalen Problemen an TechieBuddy empfehlen. Steuerberater ohne Provision.">
  <div class="container page-top">
    <header class="head">
      <h1>Partnerprogramm</h1>
      <p class="lede">Deine Kunden haben digitale Probleme, die nicht dein Kerngeschäft sind. Empfiehl sie an uns: Festpreis, Lieferzeit und ein Bericht, den du mitlesen kannst, wenn dein Kunde zustimmt.</p>
      <a class="btn btn--primary" href="/kontakt/?leistung=partner">Partner werden</a>
    </header>
  </div>
  <section class="section section--raised section--line" aria-labelledby="who-title">
    <div class="container">
      <SectionHeader id="who-title" title="Für wen das passt" text="Was du an uns übergeben kannst." />
      <ul class="grid" role="list">
        {
          partners.map((p) => (
            <li class="p">
              <Icon name={p.icon} size={20} />
              <h3>{p.who}</h3>
              <p class="p__text">{p.text}</p>
              <ul class="p__items" role="list">
                {p.items.map((i) => (
                  <li>
                    <a href={i.href}>{i.name}</a>
                  </li>
                ))}
              </ul>
              {p.note && <p class="p__note">{p.note}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <section class="section" aria-labelledby="terms-title">
    <div class="container terms">
      <SectionHeader id="terms-title" title="So funktioniert es" />
      <ol class="steps" role="list">
        <li><span class="mono">01</span><p><strong>Kurz kennenlernen.</strong> Wir stimmen ab, welche Fälle du an uns gibst und wie du informiert werden willst.</p></li>
        <li><span class="mono">02</span><p><strong>Empfehlen.</strong> Dein Kunde meldet sich bei uns, gern mit deinem Namen im Betreff.</p></li>
        <li><span class="mono">03</span><p><strong>Festpreis und Lösung.</strong> Dein Kunde bekommt Umfang, Preis und Nachweis wie alle anderen. Keine Aufschläge.</p></li>
      </ol>
      <div class="note">
        <Icon name="info" />
        <p><strong>Konditionen.</strong> Für Steuerberaterinnen und Steuerberater gibt es keine Provision, sondern gegenseitige Empfehlungen und gemeinsames Infomaterial. Für andere Partner nennen wir die Konditionen auf Anfrage.</p>
      </div>
      <a class="btn btn--primary" href="/kontakt/?leistung=partner">Partner werden</a>
    </div>
  </section>
</Base>
<style>
  .head {
    max-width: 820px;
    display: grid;
    gap: var(--s-5);
    justify-items: start;
    margin-bottom: var(--s-16);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--s-4);
  }
  .p {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--r-16);
    background: var(--card-fill);
  }
  .p :global(.icon) {
    color: var(--accent);
  }
  .p h3 {
    font-size: var(--fs-20);
  }
  .p__text {
    color: var(--text-2);
    font-size: var(--fs-14);
  }
  .p__items {
    display: grid;
    gap: 4px;
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font-size: var(--fs-14);
  }
  .p__items a {
    color: var(--text);
    text-decoration: none;
  }
  .p__items a:hover {
    color: var(--accent-hover);
  }
  .p__note {
    font-size: var(--fs-13);
    color: var(--warn);
  }
  .terms {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
    max-width: 880px;
  }
  .steps {
    display: grid;
    gap: var(--s-4);
  }
  .steps li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: var(--s-3);
    color: var(--text-2);
  }
  .steps .mono {
    color: var(--accent);
    font-size: var(--fs-13);
    padding-top: 3px;
  }
  .steps strong {
    color: var(--text);
  }
</style>
