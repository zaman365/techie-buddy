---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import PriceLabel from '../../components/PriceLabel.astro';
import { getData, site, serviceUrl } from '../../lib/data.ts';
const { serviceById } = await getData();
const items = site.deadlines.map((d) => ({ ...d, svc: serviceById.get(d.service)! }));
const today = site.asOf.iso;
---
<Base title="Pflichten-Kalender 2025 bis 2028" description={`Gesetzliche Fristen für kleine Betriebe: BFSG, E-Rechnung, EUDR, AI Act, Windows 10, Zeiterfassung, Hinweisgeberschutz, Kassen. Mit Quellen, Stand ${site.asOf.label}.`}>
  <div class="container page-top">
    <Breadcrumb items={[{ label: 'Wissen', href: '/wissen/' }, { label: 'Pflichten-Kalender' }]} />
    <header class="head">
      <h1>Pflichten-Kalender</h1>
      <p class="lede">Gesetzliche Pflichten und Fristen, die kleine Betriebe treffen, von 2025 bis 2028. Jede mit Datum, Betroffenen, nächstem Schritt und Quelle.</p>
      <p class="asof"><Icon name="calendar" size={16} />Stand: <time datetime={site.asOf.iso}>{site.asOf.label}</time>. Orientierung, keine Rechtsberatung.</p>
    </header>

    <ol class="cal" role="list">
      {
        items.map((d) => {
          const past = d.date <= today;
          return (
            <li class:list={['cal__item', past ? 'cal__item--now' : 'cal__item--next']} id={d.id}>
              <div class="cal__when">
                <time class="mono" datetime={d.date}>{d.dateLabel}</time>
                <span class="cal__state">{past ? 'gilt bereits' : 'kommt'}</span>
              </div>
              <div class="cal__body">
                <h2 class="cal__title">{d.title}</h2>
                <dl class="cal__dl">
                  <div>
                    <dt>Wer ist betroffen?</dt>
                    <dd>{d.who}</dd>
                  </div>
                  <div>
                    <dt>Was ist zu tun?</dt>
                    <dd>{d.what}</dd>
                  </div>
                </dl>
                <div class="cal__foot">
                  <a class="cal__svc" href={serviceUrl(d.svc)}>
                    <span>{d.svc.name}</span>
                    <PriceLabel price={d.svc.price.display} time={d.svc.turnaround} size="s" />
                  </a>
                  <a class="cal__src" href={d.url} rel="noopener">
                    Quelle: {d.source}
                    <Icon name="external-link" size={14} />
                  </a>
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>

    <div class="note guard">
      <Icon name="info" />
      <p><strong>Orientierung, keine Rechtsberatung.</strong> Ob und wie eine Pflicht für dich gilt, hängt vom Einzelfall ab. Wir setzen technisch und organisatorisch um; die rechtliche Bewertung trifft deine Anwältin, dein Steuerberater oder die zuständige Stelle.</p>
    </div>
  </div>
</Base>
<style>
  .head {
    margin-top: var(--s-8);
    max-width: 820px;
    display: grid;
    gap: var(--s-4);
  }
  .asof {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--text-2);
    font-size: var(--fs-14);
  }
  .asof :global(.icon) {
    color: var(--warn);
  }
  .cal {
    margin-block: var(--s-12);
    position: relative;
  }
  .cal::before {
    content: '';
    position: absolute;
    left: 200px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--line-2);
  }
  .cal__item {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--s-10);
    padding-block: var(--s-6);
    position: relative;
  }
  .cal__item::before {
    content: '';
    position: absolute;
    left: 195px;
    top: calc(var(--s-6) + 6px);
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 2px solid var(--text-3);
    background: var(--bg);
  }
  .cal__item--next::before {
    border-color: var(--warn);
  }
  .cal__when {
    display: grid;
    gap: 2px;
    align-content: start;
    text-align: right;
    padding-right: var(--s-6);
  }
  .cal__when time {
    font-size: var(--fs-16);
    color: var(--text);
  }
  .cal__item--next .cal__when time {
    color: var(--warn);
  }
  .cal__state {
    font-size: var(--fs-12);
    color: var(--text-3);
  }
  .cal__body {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--r-16);
    background: var(--card-fill);
  }
  .cal__title {
    font-size: var(--fs-20);
    letter-spacing: -0.02em;
  }
  .cal__dl {
    display: grid;
    gap: var(--s-3);
  }
  .cal__dl dt {
    font-size: var(--fs-13);
    font-weight: 560;
  }
  .cal__dl dd {
    color: var(--text-2);
    font-size: var(--fs-14);
  }
  .cal__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .cal__svc {
    display: flex;
    gap: var(--s-3);
    align-items: center;
    flex-wrap: wrap;
    font-size: var(--fs-14);
    font-weight: 540;
    text-decoration: none;
  }
  .cal__svc:hover span {
    color: var(--accent-hover);
  }
  .cal__src {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--fs-13);
    color: var(--text-2);
  }
  .guard {
    margin-bottom: var(--s-20);
    max-width: 880px;
  }
  @media (max-width: 767px) {
    .cal::before {
      left: 5px;
    }
    .cal__item {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
      padding-left: var(--s-6);
    }
    .cal__item::before {
      left: 0;
      top: calc(var(--s-6) + 5px);
    }
    .cal__when {
      text-align: left;
      padding-right: 0;
      grid-auto-flow: column;
      justify-content: start;
      gap: var(--s-3);
      align-items: baseline;
    }
    .cal__body {
      padding: var(--s-5);
    }
  }
</style>
